        {
          "id": "line_002",
          "speakerId": "npc_6",
          "speakerName": "支援電子AI",
          "type": "3.5",
          "emotion": "surprise",
          "displayMode": "portrait",
          "portraitEffect": "monitor",
          "message": "測量機Bから未登録反応の報告を受信しました。全機へ転送します。上方を警戒してください！"
        },
        {
          "id": "line_003",
          "speakerId": "npc_6",
          "speakerName": "支援電子AI",
          "type": "3.5",
          "emotion": "tense",
          "displayMode": "portrait",
          "portraitEffect": "monitor",
          "message": "測量機の観測値を事前データと照合しました。一致する対象はありません。大型飛行個体、三体です！"
        },
        {
          "id": "line_004",
          "speakerId": "placeholder_player",
          "speakerName": "主人公",
          "type": "3",
          "emotion": "serious",
          "displayMode": "portrait",
          "portraitEffect": "none",
          "message": "測量機の観測データを本機へ転送してください。対処手順を算出します。採掘班は作業を停止し、輸送地点へ退避してください"
